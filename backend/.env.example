# Port cho Backend Server
PORT=3001

# URL của Frontend (cho CORS và tạo link QR bàn)
FRONTEND_URL="http://localhost:5173"

# Chuỗi kết nối Database cho Knex migrations/seeding
# 1. Chạy PostgreSQL Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_restaurant"
# 2. Hoặc chạy Supabase Pooler (IPv4):
# DATABASE_URL="postgresql://postgres.[project_id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Tùy chọn SSL cho Database: false khi chạy local Postgres, true khi kết nối cloud (Supabase)
DB_SSL=false

# Supabase Keys
SUPABASE_URL="https://[PROJECT_ID].supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
